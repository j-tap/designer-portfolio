{
  "kind": "collectionType",
  "collectionName": "landings",
  "info": {
    "singularName": "landing",
    "pluralName": "landings",
    "displayName": "Посадочные страницы",
    "description": "Страницы услуг для поиска: /<язык>/<slug>. Страница есть только на языках, на которые переведена"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string",
      "required": true,
      "minLength": 2
    },
    "title_accent": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string"
    },
    "slug": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "uid",
      "required": true,
      "targetField": "title"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "common.seo"
    },
    "hero": {
      "type": "component",
      "repeatable": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "landing.hero"
    },
    "sections": {
      "type": "dynamiczone",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "components": [
        "landing.section-cards",
        "landing.section-cases",
        "landing.section-faq",
        "landing.section-contact"
      ]
    }
  }
}
