# The single configuration file of the project. Copy it to .env and fill it in.
# Read by docker compose (docker-compose.yml passes each service only what it needs)
# and by local runs without Docker (`yarn develop` / `yarn dev` load ../.env).
# Keep the real .env readable by the owner only: `make` runs `chmod 600 .env`.

# --- Traefik (production) ---
TRAEFIK_EMAIL=mail@mail.com
TRAEFIK_DOMAIN=localhost

# --- Strapi (backend) ---
HOST=0.0.0.0
PORT_BACKEND=1337
# Domain used in links of the notification email
DOMAIN=localhost:1337
# Public address of Strapi; in production it includes the /strapi prefix
PUBLIC_URL=http://localhost:1337
# true behind Traefik, so client IPs are taken from X-Forwarded-For
PROXY=false
# Comma-separated site origins allowed to call the API, e.g. https://example.com. Empty = any origin.
CORS_ORIGINS=

# Secrets: generate each with `openssl rand -base64 32`; APP_KEYS takes several, comma-separated
APP_KEYS=toBeModified1,toBeModified2
JWT_SECRET=tobemodified
ADMIN_JWT_SECRET=tobemodified
API_TOKEN_SALT=tobemodified

# Review notifications
ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=password
SMTP_FROM=example.com

# PostgreSQL (not used yet: Strapi runs on SQLite, see backend/config/database.js)
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=strapi
# DB_USER=strapi
# DB_PASSWORD=strapi

# --- Nuxt (frontend) ---
PORT_FRONTEND=3000
BASE_URL=http://localhost:3000
# Strapi address for server-side requests (inside Docker: the service name)
STRAPI_URL=http://strapi:1337
# Strapi address for the browser
NUXT_PUBLIC_STRAPI_URL=http://localhost:1337
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
YANDEX_METRIKA_ID=

# LinkedIn posts via vr9.pro
LINKEDIN_USER_NAME=username
VR9_API_KEY=your_vr9_api_key
# Secret for forcing a posts refresh: /api/posts?update=true&token=<value>. Empty disables it.
POSTS_UPDATE_TOKEN=
