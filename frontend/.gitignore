############################
# Yarn
############################

# Regenerated by every `yarn install`, so versioning it means a dirty working tree after
# each one. It is a local resolution cache, not part of the install contract — yarn.lock is.
# The backend already excludes it, through its blanket `*.gz` rule.
.yarn/install-state.gz

