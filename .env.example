# The single configuration file of the project. Copy it to .env and fill it in.
# Read by docker compose (docker-compose.yml passes each service only what it needs)
# and by local runs without Docker (`yarn develop` / `yarn dev` load ../.env).
# Keep the real .env readable by the owner only: `make` runs `chmod 600 .env`.

# --- Site ---
# Address of the site. Everything else is derived from it: the domain for Traefik and the
# HTTPS certificate, Strapi's address (SITE_URL + /strapi), links in emails, RSS and the
# sitemap, and the only origin allowed to call the API (CORS).
SITE_URL=https://example.com
# Only for local development: Strapi runs on its own port without the /strapi prefix
# STRAPI_PUBLIC_URL=http://localhost:1337

# Ports the apps listen on (optional, these are the defaults)
PORT_BACKEND=1337
PORT_FRONTEND=3000

# --- Strapi secrets ---
# Generate each with `openssl rand -base64 32`; APP_KEYS takes several, comma-separated
APP_KEYS=toBeModified1,toBeModified2
JWT_SECRET=tobemodified
ADMIN_JWT_SECRET=tobemodified
API_TOKEN_SALT=tobemodified

# --- Email ---
# Used for notifications about new reviews and for resetting the Strapi admin password.
# For Gmail: smtp.gmail.com, the Gmail address as the username and an app password
# (Google Account → Security → 2-Step Verification → App passwords), not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=user@gmail.com
SMTP_PASSWORD=app password
# Where notifications about new reviews are sent
NOTIFY_EMAIL=you@example.com
# Optional sender address; Gmail allows only the account itself or an alias confirmed in it.
# Defaults to SMTP_USERNAME.
# SMTP_FROM=noreply@example.com

# --- Analytics and search engines (optional) ---
YANDEX_METRIKA_ID=
# Codes of the <meta> verification tags from Google Search Console and Yandex Webmaster
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# --- LinkedIn posts via vr9.pro ---
LINKEDIN_USER_NAME=username
VR9_API_KEY=your_vr9_api_key
# Secret for forcing a posts refresh: /api/posts?update=true&token=<value>. Empty disables it.
POSTS_UPDATE_TOKEN=
